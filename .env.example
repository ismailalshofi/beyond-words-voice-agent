# LLM: openai (also any OpenAI-compatible API) or google (Gemini)
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional: any OpenAI-compatible endpoint, e.g. https://openrouter.ai/api/v1 or https://api.groq.com/openai/v1
# OPENAI_BASE_URL=

# Gemini: LLM_PROVIDER=google and a key from https://aistudio.google.com/apikey
# GOOGLE_API_KEY=

# Empty means the provider's default (gpt-4.1-mini, gemini-2.5-flash)
# LLM_MODEL=

ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# deepgram or scribe (ElevenLabs Scribe uses ELEVENLABS_API_KEY)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# DATABASE_URL=sqlite+aiosqlite:///./voice_agent.db
